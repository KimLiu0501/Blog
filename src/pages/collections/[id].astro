---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPostsInCollection, postUrl } from '../../lib/posts';
import { COLLECTION_IDS, getCollectionMeta } from '../../collections';
import { formatShortDate } from '../../site';

// 为每个合集生成一页
export function getStaticPaths() {
  return COLLECTION_IDS.map((id) => ({ params: { id } }));
}

const { id } = Astro.params;
const meta = getCollectionMeta(id!);
const posts = await getPostsInCollection(id!);
---

<BaseLayout title={meta.title} description={meta.description}>
  <div class="section-head">
    <h2>{meta.title}</h2>
    <span class="more">{posts.length} 篇</span>
  </div>

  {meta.description && <p style="color: var(--text-muted); margin-top: -0.5rem">{meta.description}</p>}

  {
    posts.length === 0 ? (
      <p class="empty">这个合集还空着。</p>
    ) : (
      <ul class="post-list">
        {posts.map((entry) => (
          <li class="post-item">
            <a class="post-item-title" href={postUrl(entry)}>{entry.data.title}</a>
            {entry.data.draft && <span class="draft-badge">草稿</span>}
            {entry.data.description && <p class="post-item-desc">{entry.data.description}</p>}
            <div class="post-meta">
              <time datetime={entry.data.pubDate.toISOString()}>
                {formatShortDate(entry.data.pubDate)}
              </time>
            </div>
          </li>
        ))}
      </ul>
    )
  }

  <p style="margin-top: 2.5rem">
    <a href="/collections">← 全部合集</a>
  </p>
</BaseLayout>
